# --- Discord ---
# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID=
# ID du serveur Discord (mode dev activé > clic droit sur le serveur > Copier l'identifiant)
# Utilisé pour déployer les commandes instantanément sur ta guilde
DISCORD_GUILD_ID=

# --- Warcraft Logs (API v2) ---
# https://www.warcraftlogs.com/api/clients/
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# --- Firebase (Firestore) ---
# Compte de service : Console Firebase > Paramètres du projet > Comptes de service
# > Générer une nouvelle clé privée. Place le fichier JSON à la racine (serviceAccount.json)
# ou indique son chemin ici :
FIREBASE_SERVICE_ACCOUNT_PATH=
# Nom de la collection Firestore (optionnel, défaut : discordWowLinks)
FIREBASE_COLLECTION=discordWowLinks
