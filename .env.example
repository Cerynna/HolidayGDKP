# Variables utilisées uniquement par le script local `npm run register`.
# Les Cloud Functions lisent leurs secrets via Secret Manager, pas ce fichier.

# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID=
# ID du serveur Discord (mode dev activé > clic droit sur le serveur > Copier l'identifiant)
# Les commandes sont enregistrées sur cette guilde (déploiement instantané)
DISCORD_GUILD_ID=
